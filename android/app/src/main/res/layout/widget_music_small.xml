<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/widget_cover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:src="@drawable/widget_cover_placeholder" />

  <ImageView
    android:id="@+id/widget_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_scrim" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginBottom="7dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    android:paddingTop="9dp"
    android:paddingBottom="10dp">

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:maxLines="1"
      android:ellipsize="end"
      android:textColor="#FFFFFFFF"
      android:textSize="14.5sp"
      android:textStyle="bold"
      android:text="Emo 音乐" />

    <TextView
      android:id="@+id/widget_singer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:maxLines="1"
      android:ellipsize="end"
      android:layout_marginTop="1dp"
      android:textColor="#CCFFFFFF"
      android:textSize="10.5sp"
      android:text="未在播放" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="38dp"
      android:layout_marginTop="8dp"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <FrameLayout android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1">
        <ImageView android:id="@+id/widget_prev_bg" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" />
        <ImageView android:id="@+id/widget_prev" android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:src="@drawable/widget_prev" />
      </FrameLayout>

      <FrameLayout android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1">
        <ImageView android:id="@+id/widget_play_bg" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" />
        <ImageView android:id="@+id/widget_play" android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:src="@drawable/widget_play" />
      </FrameLayout>

      <FrameLayout android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1">
        <ImageView android:id="@+id/widget_next_bg" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" />
        <ImageView android:id="@+id/widget_next" android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:src="@drawable/widget_next" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
